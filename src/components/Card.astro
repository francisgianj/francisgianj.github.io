---
export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div
  class="text-black dark:text-white h-72 w-auto px-6 py-3 sm:px-12 sm:py-6 border border-slate-50/50 rounded-2xl shadow-lg"
>
  <h2 class="font-bold text-xl mb-3 sm:mb-4">
    {title}
  </h2>
  <div class="grid grid-cols-2">
    <slot />
  </div>
</div>
