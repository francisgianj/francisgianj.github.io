---
import Header from "@components/Header";
export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400;1,500;1,700&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />

    <!-- <meta property="og:image" content={meta.image} /> -->
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta
      name="description"
      content="I'm Francis. I am actively seeking a permanent job where I can contribute my skills to help developers create faster and more efficient products that will drive the company's success."
    />
    <meta
      property="og:description"
      content="I'm Francis. I am actively seeking a permanent job where I can contribute my skills to help developers create faster and more efficient products that will drive the company's success."
    />
    <meta property="og:site_name" content="Francis Gian Juson" />

    <title>{title}</title>
  </head>
  <body class="font-dm-sans bg-slate-50 dark:bg-slate-900">
    <Header client:load />
    <main class="px-8 bg-slate-50 dark:bg-slate-900">
      <div
        class="max-w-2xl border-slate-200 dark:border-slate-700 mx-auto pb-16"
      >
        <slot />
      </div>
    </main>
  </body>
</html>
