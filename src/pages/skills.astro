---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import Skill from "../components/Skill.astro";
---

<Layout title="Skills | Francis Gian Juson">
  <h1 class="text-black dark:text-white font-bold text-3xl font-serif">
    Skills
  </h1>
  <h2 class="text-gray-500 dark:text-gray-400 text-lg font-bold mb-10">
    My Technical Level
  </h2>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
    <Card title="Frontend Skills">
      <Skill skill="HTML" level="Advanced" />
      <Skill skill="CSS" level="Advanced" />
      <Skill skill="JavaScript" level="Advanced" />
      <Skill skill="React" level="Advanced" />
      <Skill skill="Next.Js" level="Advanced" />
      <Skill skill="TailwindCSS" level="Advanced" />
      <Skill skill="Bootstrap" level="Intermediate" />
    </Card>
    <Card title="Technical Skills (Web Development)">
      <Skill skill="Git" level="Advanced" />
      <Skill skill="GitHub" level="Advanced" />
      <Skill skill="Figma" level="Intermediate" />
      <Skill skill="Adobe XD" level="Intermediate" />
      <Skill skill="Responsive Design" level="Intermediate" />
      <Skill skill="SEO" level="Intermediate" />
    </Card>
    <Card title="Programming Languages">
      <Skill skill="JavaScript" level="Advanced" />
      <Skill skill="TypeScript" level="Advanced" />
      <Skill skill="Python" level="Advanced" />
      <Skill skill="PHP" level="Basic" />
    </Card>
    <Card title="Database Technologies">
      <Skill skill="MongoDB" level="Intermediate" />
      <Skill skill="MySQL" level="Intermediate" />
      <Skill skill="PostgreSQL" level="Intermediate" />
    </Card>
  </div>
</Layout>
