---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Francis Gian Juson">
  <div class="flex flex-col pr-8">
    <h1 class="text-black dark:text-white font-bold text-3xl font-serif">
      Francis Gian Juson
    </h1>
    <h2 class="text-slate-700 dark:text-slate-200 mb-4">Software Engineer</h2>
    <div class="prose prose-sm md:prose-base">
      <p class="text-slate-600 dark:text-slate-400">
        Hello, I'm Francis. I am <span class="font-bold"
          >actively seeking a permanent job</span
        > where I can contribute my skills to help developers create faster and more
        efficient products that will drive the company's success.
      </p>
      <p class="text-slate-600 dark:text-slate-400">
        As a computer science student who will be graduating soon, I have a
        solid foundation in programming and front-end development. I am
        currently on the lookout for a permanent position or freelance
        opportunities where I can apply my skills and expertise, learn new
        things, and contribute to the company's success while helping people
        reach their goals. I have experience creating responsive web
        applications, as well as working on machine learning and artificial
        intelligence projects.
      </p>
    </div>
  </div>
</Layout>
