---
import Layout from "../layouts/Layout.astro";

---

<Layout title="Francis Gian Juson">
  <div class="flex flex-col pr-8">
    <h1 class="text-black dark:text-white font-bold text-3xl font-serif">
      Francis Gian Juson
    </h1>
    <h2 class="text-slate-700 dark:text-slate-200 mb-4">Software Engineer</h2>
    <p class="text-slate-600 dark:text-slate-400 mb-16">
      A Senior Computer Science Student with a strong background in programming
      and front-end development. Seeking for an internship role where I can use
      my skills, expand my knowledge, and to help the company reach its goals.
      Has experience in building responsive web applications, machine learning,
      and artificial intelligence projects.
    </p>
  </div>
</Layout>
